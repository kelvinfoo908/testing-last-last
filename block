  <script>
    // EDIT
    const WHATSAPP_NUMBER = '60167258223';

    function whatsAppUrl(message) {
      return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    }

    document.querySelectorAll('.wa-link').forEach(link => {
      link.href = whatsAppUrl(
        link.dataset.message || "Hi Kelvin, I'd like to discuss a property."
      );
    });

    const menuToggle = document.querySelector('#menu-toggle');
    const siteNav = document.querySelector('#site-nav');

    function setMenu(open, restoreFocus = false) {
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      siteNav.dataset.open = String(open);

      if (restoreFocus) {
        menuToggle.focus();
      }
    }

    menuToggle.addEventListener('click', () => {
      setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    siteNav.addEventListener('click', event => {
      if (event.target.closest('a')) {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', event => {
      if (
        event.key === 'Escape' &&
        menuToggle.getAttribute('aria-expanded') === 'true'
      ) {
        setMenu(false, true);
      }
    });

    window.addEventListener('resize', () => {
      if (innerWidth >= 980) {
        setMenu(false);
      }
    });

    const leadForm = document.querySelector('#lead-form');
    const formStatus = document.querySelector('#form-status');

    leadForm.addEventListener('submit', event => {
      event.preventDefault();
      formStatus.classList.remove('success');

      const name = leadForm.name.value.trim();
      const phone = leadForm.phone.value.trim();
      const message = leadForm.message.value.trim();

      if (!name || !phone || !message) {
        formStatus.textContent =
          'Please complete your name, phone and message.';
        leadForm.querySelector(':invalid')?.focus();
        return;
      }

      if (!/^[+\d][\d\s()-]{7,}$/.test(phone)) {
        formStatus.textContent = 'Please enter a valid phone number.';
        leadForm.phone.focus();
        return;
      }

      formStatus.textContent = 'Opening WhatsApp…';
      formStatus.classList.add('success');

      const text =
        `Hi Kelvin, my name is ${name}.\n\n` +
        `Phone: ${phone}\n\n` +
        `I'm looking for: ${message}`;

      window.open(
        whatsAppUrl(text),
        '_blank',
        'noopener,noreferrer'
      );
    });

    const contactSection = document.querySelector('#contact');

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        document.body.classList.toggle(
          'contact-in-view',
          entry.isIntersecting
        );
      }, {
        threshold: .08
      }).observe(contactSection);
    }

    document.querySelector('#year').textContent =
      new Date().getFullYear();
  </script>
