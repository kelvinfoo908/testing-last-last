  <style>
    :root {
      --ink: #11110f;
      --paper: #fff;
      --soft: #f5f3ee;
      --muted: #686761;
      --line: #dfdcd4;
      --accent: #c7a86b;
      --success: #126b42;
      --radius: 22px;
      --shadow: 0 18px 50px rgba(17, 17, 15, .09);
      --max: 1180px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 82px;
    }

    body {
      margin: 0;
      overflow-x: hidden;
      background: var(--paper);
      color: var(--ink);
      font-family: Inter, system-ui, sans-serif;
      line-height: 1.65;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button,
    a,
    input,
    textarea {
      font-size: 1rem;
    }

    .container {
      width: min(calc(100% - 28px), var(--max));
      margin-inline: auto;
    }

    .section {
      padding: 76px 0;
    }

    .skip-link {
      position: fixed;
      z-index: 1000;
      top: 12px;
      left: 12px;
      padding: 10px 15px;
      border-radius: 10px;
      background: var(--ink);
      color: white;
      transform: translateY(-150%);
    }

    .skip-link:focus {
      transform: none;
    }

    .eyebrow {
      margin: 0 0 14px;
      color: #655632;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      display: inline-block;
      width: 22px;
      height: 2px;
      margin-right: 9px;
      background: var(--accent);
      content: "";
      vertical-align: middle;
    }

    h1,
    h2,
    h3,
    .brand {
      font-family: Poppins, sans-serif;
      line-height: 1.08;
      letter-spacing: -.035em;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.7rem, 12vw, 5.25rem);
    }

    h2 {
      margin: 0;
      font-size: clamp(2rem, 8vw, 3.4rem);
    }

    h3 {
      margin: 0;
      font-size: 1.24rem;
    }

    .lead {
      margin: 22px 0 0;
      color: var(--muted);
      font-size: 1.06rem;
    }

    .button {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 12px 19px;
      border: 1px solid var(--ink);
      border-radius: 999px;
      background: var(--ink);
      color: white;
      cursor: pointer;
      font-weight: 600;
      text-decoration: none;
      transition: .2s;
    }

    .button-outline {
      background: transparent;
      color: var(--ink);
    }

    .button svg {
      width: 18px;
    }

    .card {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: white;
      box-shadow: 0 8px 32px rgba(17, 17, 15, .05);
    }

    .section-head {
      margin-bottom: 36px;
    }

    .section-head p:last-child {
      max-width: 570px;
      color: var(--muted);
    }

    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
    }

    .site-header {
      position: sticky;
      z-index: 100;
      top: 0;
      border-bottom: 1px solid rgba(223, 220, 212, .8);
      background: rgba(255, 255, 255, .9);
      backdrop-filter: blur(16px);
    }

    .nav-wrap {
      position: relative;
      display: flex;
      height: 70px;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-weight: 700;
      text-decoration: none;
    }

    .brand small {
      display: block;
      color: var(--muted);
      font: 500 .61rem Inter, sans-serif;
      letter-spacing: .16em;
    }

    .menu-toggle {
      display: grid;
      width: 46px;
      height: 46px;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: white;
      cursor: pointer;
    }

    .menu-toggle span,
    .menu-toggle::before,
    .menu-toggle::after {
      display: block;
      width: 19px;
      height: 2px;
      margin: 3px auto;
      background: var(--ink);
      content: "";
    }

    .site-nav {
      position: absolute;
      top: 76px;
      right: 0;
      left: 0;
      display: grid;
      gap: 4px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: white;
      box-shadow: var(--shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: .2s;
    }

    .site-nav[data-open="true"] {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-nav > a:not(.button) {
      padding: 10px;
      font-weight: 600;
      text-decoration: none;
    }

    .hero {
      padding: 54px 0 70px;
      background: linear-gradient(180deg, #fff 0 67%, var(--soft) 67%);
    }

    .hero-grid {
      display: grid;
      gap: 38px;
    }

    .hero-copy {
      align-self: center;
    }

    .hero-actions {
      display: grid;
      gap: 10px;
      margin-top: 30px;
    }

    .hero-proof {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 25px;
      color: var(--muted);
      font-size: .83rem;
    }

    .initials {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      place-items: center;
      border-radius: 50%;
      background: var(--ink);
      color: white;
      font: 600 .75rem Poppins;
    }

    .portrait-wrap {
      position: relative;
      max-width: 510px;
      margin-inline: auto;
    }

    .portrait {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: 30px;
      box-shadow: var(--shadow);
      filter: grayscale(100%);
      object-fit: cover;
      object-position: center;
    }

    .portrait-badge {
      position: absolute;
      right: -4px;
      bottom: 22px;
      padding: 14px 17px;
      border-radius: 16px;
      background: var(--accent);
      box-shadow: var(--shadow);
      font-size: .74rem;
    }

    .portrait-badge strong {
      display: block;
      font: 700 1rem Poppins;
    }

    .about-grid {
      display: grid;
      gap: 38px;
    }

    .about-copy p {
      color: var(--muted);
    }

    .stats {
      display: grid;
      gap: 12px;
    }

    .stat {
      padding: 23px;
    }

    .stat strong {
      display: block;
      font: 600 1.65rem Poppins;
    }

    .stat span {
      color: var(--muted);
      font-size: .85rem;
    }

    .listings {
      background: var(--soft);
    }

    .listing-grid {
      display: grid;
      gap: 20px;
    }

    .listing-card img {
      width: 100%;
      aspect-ratio: 16 / 10;
      background: #ddd;
      object-fit: cover;
    }

    .listing-body {
      padding: 22px;
    }

    .listing-location {
      margin: 0 0 7px;
      color: var(--muted);
      font-size: .8rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .price {
      margin: 12px 0 16px;
      font: 600 1.55rem Poppins;
    }

    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 22px;
      padding: 0;
      list-style: none;
    }

    .facts li {
      padding: 7px 10px;
      border-radius: 999px;
      background: var(--soft);
      color: var(--muted);
      font-size: .78rem;
    }

    .listing-card .button {
      width: 100%;
    }

    .why-grid {
      display: grid;
      gap: 16px;
    }

    .why-card {
      padding: 28px;
    }

    .why-icon {
      display: grid;
      width: 48px;
      height: 48px;
      margin-bottom: 35px;
      place-items: center;
      border-radius: 14px;
      background: var(--soft);
    }

    .why-icon svg {
      width: 22px;
    }

    .why-card p {
      margin-bottom: 0;
      color: var(--muted);
    }

    .testimonials {
      background: var(--ink);
      color: white;
    }

    .testimonials .section-head p:last-child {
      color: #b3b0a8;
    }

    .testimonial-grid {
      display: grid;
      gap: 16px;
    }

    .quote {
      padding: 28px;
      border-color: #373730;
      background: #20201d;
      box-shadow: none;
    }

    .sample {
      display: inline-block;
      margin-bottom: 18px;
      padding: 5px 9px;
      border: 1px solid #4b4941;
      border-radius: 999px;
      color: #d7c69e;
      font-size: .68rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .quote blockquote {
      margin: 0 0 24px;
      font-size: 1.03rem;
    }

    .quote footer {
      color: #aaa79f;
      font-size: .82rem;
    }

    .faq-grid {
      display: grid;
      gap: 34px;
    }

    .faq-list details {
      border-top: 1px solid var(--line);
    }

    .faq-list details:last-child {
      border-bottom: 1px solid var(--line);
    }

    .faq-list summary {
      display: flex;
      min-height: 62px;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      cursor: pointer;
      font: 600 1rem Poppins;
      list-style: none;
    }

    .faq-list summary::-webkit-details-marker {
      display: none;
    }

    .faq-list summary::after {
      content: "+";
      font: 400 1.4rem Inter;
    }

    .faq-list details[open] summary::after {
      content: "−";
    }

    .faq-list details p {
      margin: 0;
      padding: 0 35px 22px 0;
      color: var(--muted);
    }

    .contact {
      background: var(--soft);
    }

    .contact-grid {
      display: grid;
      gap: 34px;
    }

    .contact-copy p {
      color: var(--muted);
    }

    .contact-note {
      padding: 20px;
      border-radius: 16px;
      background: var(--ink);
      color: white;
    }

    .contact-note strong {
      display: block;
      font-family: Poppins;
    }

    .contact-note span {
      color: #c3c0b7;
      font-size: .85rem;
    }

    .lead-form {
      padding: 24px;
    }

    .field {
      margin-bottom: 17px;
    }

    .field label {
      display: block;
      margin-bottom: 7px;
      font-size: .88rem;
      font-weight: 600;
    }

    .field input,
    .field textarea {
      width: 100%;
      min-height: 48px;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      color: var(--ink);
    }

    .field textarea {
      min-height: 130px;
      resize: vertical;
    }

    .form-note,
    .form-status {
      font-size: .78rem;
    }

    .form-note {
      color: var(--muted);
    }

    .form-status {
      min-height: 1.3em;
      color: #9e2b25;
    }

    .form-status.success {
      color: var(--success);
    }

    .lead-form .button {
      width: 100%;
      margin-top: 8px;
    }

    .site-footer {
      padding: 36px 0 110px;
    }

    .footer-grid {
      display: grid;
      gap: 18px;
      padding-top: 25px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: .82rem;
    }

    .footer-grid p {
      margin: 0;
    }

    .floating-wa {
      position: fixed;
      z-index: 90;
      right: 14px;
      bottom: 14px;
      display: grid;
      width: 58px;
      height: 58px;
      place-items: center;
      border-radius: 50%;
      background: var(--ink);
      box-shadow: 0 14px 34px rgba(0, 0, 0, .25);
      color: white;
      text-decoration: none;
      transition: opacity .2s, transform .2s;
    }

    .contact-in-view .floating-wa {
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px);
    }

    .floating-wa svg {
      width: 27px;
    }

    @media (min-width: 700px) {
      .section {
        padding: 100px 0;
      }

      .container {
        width: min(calc(100% - 48px), var(--max));
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 35px;
        margin-bottom: 46px;
      }

      .hero {
        padding: 70px 0 85px;
      }

      .hero-grid {
        grid-template-columns: 1.05fr .95fr;
        align-items: center;
      }

      .hero-actions {
        display: flex;
      }

      .hero-copy .lead {
        max-width: 610px;
      }

      .about-grid,
      .contact-grid,
      .faq-grid {
        grid-template-columns: .9fr 1.1fr;
        align-items: start;
      }

      .stats {
        grid-template-columns: repeat(3, 1fr);
      }

      .listing-grid,
      .why-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .listing-card:last-child,
      .why-card:last-child {
        grid-column: 1 / -1;
      }

      .testimonial-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: 1fr auto;
        text-align: left;
      }

      .footer-grid p:last-child {
        text-align: right;
      }

      .lead-form {
        padding: 34px;
      }
    }

    @media (min-width: 980px) {
      .nav-wrap {
        height: 78px;
      }

      .menu-toggle {
        display: none;
      }

      .site-nav {
        position: static;
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        opacity: 1;
        visibility: visible;
        transform: none;
      }

      .site-nav > a:not(.button) {
        padding: 5px;
        color: var(--muted);
        font-size: .88rem;
      }

      .hero {
        display: grid;
        min-height: calc(100vh - 78px);
        align-items: center;
      }

      .hero-grid {
        gap: 76px;
      }

      .listing-grid,
      .why-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .listing-card:last-child,
      .why-card:last-child {
        grid-column: auto;
      }

      .floating-wa {
        right: 24px;
        bottom: 24px;
        display: flex;
        width: auto;
        height: 56px;
        gap: 10px;
        padding: 0 20px;
        border-radius: 999px;
      }

      .floating-wa::after {
        content: "WhatsApp";
        font-weight: 600;
      }
    }

    @media (hover: hover) {
      .button:hover,
      .floating-wa:hover {
        transform: translateY(-2px);
      }

      .card {
        transition: transform .2s, box-shadow .2s;
      }

      .listing-card:hover,
      .why-card:hover {
        box-shadow: var(--shadow);
        transform: translateY(-5px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>

