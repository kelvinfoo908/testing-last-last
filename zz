      document.getElementById("propertyPrice"),
      document.getElementById("downPayment"),
      document.getElementById("interestRate"),
      document.getElementById("loanYears")
    ];

    const calculatorOutputs = {
      payment: document.getElementById("monthlyPayment"),
      down: document.getElementById("downAmount"),
      principal: document.getElementById("loanAmount"),
      interest: document.getElementById("totalInterest"),
      total: document.getElementById("totalRepayment")
    };

    const calculatorError = document.getElementById("calculatorError");
    const budgetWhatsApp = document.getElementById("budgetWhatsApp");

    function updateCalculator() {
      let valid = true;

      calculatorInputs.forEach((input) => {
        const inputValid = input.value.trim() !== "" &&
          Number.isFinite(Number(input.value)) &&
          input.validity.valid;

        input.setAttribute("aria-invalid", String(!inputValid));
        if (!inputValid) valid = false;
      });

      if (!valid) {
        calculatorError.textContent =
          "Use RM10,000–100,000,000, a 0–100% deposit, 0–20% rate and 1–35 whole years.";

        Object.values(calculatorOutputs).forEach((output) => {
          output.textContent = "—";
        });

        budgetWhatsApp.href = whatsappURL(
          "Hi Kelvin, I'd like help understanding my home buying budget."
        );
        return;
      }

      calculatorError.textContent = "";

      const [price, downPercent, rate, years] =
        calculatorInputs.map((input) => Number(input.value));

      const result = calculateLoan(price, downPercent, rate, years);

      Object.entries(calculatorOutputs).forEach(([key, output]) => {
        output.textContent = money.format(result[key]);
      });

      budgetWhatsApp.href = whatsappURL(
        `Hi Kelvin, I'd like to discuss my home buying budget.\n\n` +
        `Property price: ${money.format(price)}\n` +
        `Down payment: ${downPercent}% (${money.format(result.down)})\n` +
        `Loan amount: ${money.format(result.principal)}\n` +
        `Assumed annual rate: ${rate}%\n` +
        `Tenure: ${years} years\n` +
        `Estimated monthly instalment: ${money.format(result.payment)}\n\n` +
        `Could you help me explore suitable landed homes?`
      );
    }

    calculatorInputs.forEach((input) => {
      input.addEventListener("input", updateCalculator);
    });

    updateCalculator();

    // Lead form: prepare a message; never claim it has been sent.
    const leadForm = document.getElementById("leadForm");
    const leadName = document.getElementById("leadName");
    const leadPhone = document.getElementById("leadPhone");
    const leadMessage = document.getElementById("leadMessage");
    const formStatus = document.getElementById("formStatus");

    leadName.addEventListener("input", () => leadName.setCustomValidity(""));
    leadPhone.addEventListener("input", () => leadPhone.setCustomValidity(""));
    leadMessage.addEventListener("input", () => leadMessage.setCustomValidity(""));

    leadForm.addEventListener("submit", (event) => {
      event.preventDefault();
      formStatus.textContent = "";

      const name = leadName.value.trim();
      const phone = leadPhone.value.trim();
      const message = leadMessage.value.trim();
      const phoneDigits = phone.replace(/\D/g, "");

      leadName.setCustomValidity(name.length >= 2 ? "" : "Please enter your name.");
      leadMessage.setCustomValidity(
        message.length >= 5 ? "" : "Please share a little about your requirements."
      );

      const phoneValid = /^[+()\d\s.-]+$/.test(phone) &&
        phoneDigits.length >= 8 && phoneDigits.length <= 15;

      leadPhone.setCustomValidity(
        phoneValid ? "" : "Please enter a valid phone number with 8–15 digits."
      );

      if (!leadForm.reportValidity()) return;

      const text =
        `Hi Kelvin, I'd like a property consultation.\n\n` +
        `Name: ${name}\nPhone: ${phone}\n\n${message}`;

      // Same-tab navigation avoids popup blockers and works with WhatsApp Web/app.
      formStatus.textContent = "Opening WhatsApp. Review your message and press Send there.";
      window.location.assign(whatsappURL(text));
    });
  </script>
</body>
</html>
