      if (event.matches) closeMenu();
    });

    // Constant-rate monthly amortisation; supports 0% interest and 100% down payment.
    function calculateLoan(price, downPercent, annualRate, years) {
      const principal = price * (1 - downPercent / 100);
      const months = years * 12;
      const monthlyRate = annualRate / 1200;

      const payment = principal === 0
        ? 0
        : monthlyRate === 0
          ? principal / months
          : principal * monthlyRate /
            (-Math.expm1(-months * Math.log1p(monthlyRate)));

      return {
        principal,
        down: price - principal,
        payment,
        total: payment * months,
        interest: Math.max(0, payment * months - principal)
      };
    }

    const money = new Intl.NumberFormat("en-MY", {
      style: "currency",
      currency: "MYR",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

